# Copy this file to server/.env and fill in your real values.
# Never commit server/.env to Git.

# Neon PostgreSQL — use the "Pooled connection" string from the Neon dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# API port (default 5000)
PORT=5000

# Frontend origin for CORS — comma-separated for multiple origins
# Local: http://localhost:5173
# Production: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# development | production | test
NODE_ENV=development

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary — file uploads (receipts + gallery photos)
# Setup guide: docs/CLOUDINARY.md
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload folder prefix (creates shutterdesk/receipts, shutterdesk/galleries, etc.)
CLOUDINARY_FOLDER_PREFIX=shutterdesk

# Optional — error tracking (structured JSON logs always enabled)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
