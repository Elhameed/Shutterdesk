# Isolated environment for the API integration tests (server/tests/**).
# Copy to server/.env.test — it is git-ignored and loaded (with override) by
# vitest.config.ts, so tests NEVER touch the database in server/.env.
#
# Use ONE of the following for DATABASE_URL:
#
#   1. Local Postgres (fastest — sub-millisecond round trips, recommended for dev):
#        DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shutterdesk_test?schema=public"
#
#   2. A dedicated Neon *test branch* (isolated from your dev/prod branch):
#        Create a branch in the Neon console, then paste its pooled connection string.
#        DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shutterdesk_test?schema=public"

# Must be at least 32 characters. Any throwaway value works for tests.
JWT_SECRET="test-secret-value-please-change-min-32-chars"

NODE_ENV="test"
